{
  "rules": {
    ".read": false,
    ".write": false,
    "RoomsV2": {
      "publicRooms": {
        ".read": "auth != null",
        ".write": false,
        ".indexOn": ["updatedAt"],
        "$roomId": {
          "$other": { ".validate": false }
        }
      },
      "publicMembers": {
        "$roomId": {
          ".read": "auth != null && root.child('RoomsV2/membershipIndexByUser').child(auth.uid).child($roomId).child('active').val() == true",
          ".write": false
        }
      },
      "publicMessages": {
        "$roomId": {
          ".read": "auth != null && root.child('RoomsV2/membershipIndexByUser').child(auth.uid).child($roomId).child('active').val() == true",
          ".write": false,
          ".indexOn": ["seq"]
        }
      },
      "membershipIndexByUser": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      },
      "conversationIndexByUser": {
        "$uid": {
          "$roomId": {
            ".read": "auth != null && auth.uid == $uid && root.child('RoomsV2/membershipIndexByUser').child($uid).child($roomId).child('active').val() == true",
            ".write": false
          }
        }
      },
      "privateMessages": {
        "$conversationId": {
          ".read": "auth != null && root.child('RoomsV2/private/conversationReaders').child($conversationId).child(auth.uid).val() == true",
          ".write": false,
          ".indexOn": ["seq"]
        }
      },
      "reports": {
        "$roomId": {
          ".read": "auth != null && root.child('RoomsV2/membershipIndexByUser').child(auth.uid).child($roomId).child('active').val() == true && (root.child('RoomsV2/membershipIndexByUser').child(auth.uid).child($roomId).child('role').val() == 'owner' || root.child('RoomsV2/membershipIndexByUser').child(auth.uid).child($roomId).child('role').val() == 'moderator')",
          ".write": false,
          ".indexOn": ["createdAt"]
        }
      },
      "private": {
        ".read": false,
        ".write": false
      },
      "$other": {
        ".write": false
      }
    }
  }
}
