{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python313",
      "ignore": ["venv", ".venv", "__pycache__", "tests", ".git", "*.log"]
    }
  ],
  "database": {
    "rules": "build/generated/firebase/database.rooms-combined.rules.json"
  },
  "storage": {
    "rules": "storage.local.rules"
  },
